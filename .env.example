# CiviCRM base URL (no trailing slash)
CIVICRM_BASE_URL=https://crm.example.org

# CMS host: drupal | wordpress | standalone | backdrop
CIVICRM_CMS=drupal

# API key of the "MCP bot" contact (generate from Contact summary → More → API Key)
CIVICRM_API_KEY=

# Optional: only needed if the install enables AuthX site-key guard
CIVICRM_SITE_KEY=

# authx (recommended) | legacy
CIVICRM_AUTH_MODE=authx

# Write safety — defaults to read-only
CIVICRM_ALLOW_WRITES=false
CIVICRM_ALLOW_DELETES=false

# Optional HTTP timeout in ms
CIVICRM_TIMEOUT_MS=30000
